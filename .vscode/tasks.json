{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Запуск проекта",
      "type": "shell",
      "command": "npm run go:start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "↻ Обновить проект",
      "type": "shell",
      "command": "npm run go:update",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "■ Остановить проект",
      "type": "shell",
      "command": "npm run go:stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Run Project (API + Flutter)",
      "type": "shell",
      "command": "npm run dev:start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Stop Project",
      "type": "shell",
      "command": "npm run dev:stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Restart Project",
      "type": "shell",
      "command": "npm run dev:restart",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
