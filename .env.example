# =============================================================================
# istochchnik_zhizni — шаблон окружения (скопируйте: cp .env.example .env)
# Стек: Flutter Web + Node/Express API + PostgreSQL
# Деплой: VPS/Docker (основной), Vercel только статический Flutter web + внешний API
# =============================================================================

# --- Node API (хост + Docker) ---
# Локально на машине с npm run dev: лучше NODE_ENV=development (см. также .env.local.example)
NODE_ENV=production

# Порт API на хосте (проброс в контейнер :40978). Не меняйте контейнерный 40978 без правки docker/nginx-web.unified.conf.
PORT=40978

# CORS: перечислите Origin фронтенда без завершающего /. Пусто = любой Origin (для одного домена за nginx ок; в public API лучше задать явно).
# Пример: CORS_ALLOWED_ORIGINS=https://myapp.vercel.app,https://www.example.com
# Алиас: CORS_ORIGIN=...  |  JSON: CORS_ALLOWED_ORIGINS=["https://a.com","https://b.com"]
# CORS_ALLOWED_ORIGINS=

# Express за reverse proxy (nginx): X-Forwarded-* (по умолчанию вкл.). Локально без прокси: TRUST_PROXY=false
# TRUST_PROXY=true

# --- PostgreSQL (обязательно для API) ---
# Полный стек в Docker (api в контейнере): хост сервиса = db
DATABASE_URL=postgresql://postgres:postgres@db:5432/istochik_db
# API на хосте (npm run dev), Postgres в Docker: скопируйте .env.local.example → .env
# и используйте localhost + POSTGRES_HOST_PORT ниже.

# Порт Postgres на localhost при npm run db:up (файл docker-compose.local.yml). Если 5432 занят — поставьте 5433 и поправьте DATABASE_URL.
POSTGRES_HOST_PORT=5432

# Supabase / managed SSL:
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-....pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_DEBUG_LOG=false

# Пул соединений (опционально)
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=15000

# true = не вызывать initDb() при старте (схема уже на сервере, например Supabase после миграций)
SKIP_DB_INIT_ON_START=false

# Переменные только для сервиса Postgres в docker-compose.yml
POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Auth API ---
AUTH_SESSION_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5

# --- Docker: веб (nginx + React/Vite, см. Dockerfile.web) ---
WEB_PORT=8080
WEB_DIST_PATH=/opt/istochik-web

# Локальная разработка web-react (vite proxy), не используется при production build в Docker
# VITE_DEV_API_PROXY=http://127.0.0.1:40978

# =============================================================================
# Прочее (необязательно)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
