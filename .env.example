PORT=3000

POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For Docker Compose, host must be "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/istochik_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

AUTH_SESSION_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5
# Supabase alternative (uncomment and replace values if needed):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# DB_SSL_REJECT_UNAUTHORIZED=false
