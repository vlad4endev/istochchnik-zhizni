PORT=40978
WEB_PORT=8080
WEB_DIST_PATH=/opt/istochik-web

POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For Docker Compose, host must be "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/istochik_db
DB_SSL=false
# При DB_SSL=true к managed-БД (Supabase): обычно false, иначе SELF_SIGNED_CERT_IN_CHAIN. Строгая проверка цепочки CA — true.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_DEBUG_LOG=false
# Опционально: размер пула и таймауты (см. src/config/db.ts)
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=15000
SKIP_DB_INIT_ON_START=false

AUTH_SESSION_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5

# --- Supabase (веб-клиент: Next.js / Vite; не подставляйте в публичный репозиторий) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xpefqjwxwgnkicizqyqx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Бэкенд Node (src/) подключается к Postgres по DATABASE_URL.
# Пароль: Supabase → Project Settings → Database → Database password (не anon/publishable key).
# Для миграций и Node API — только Session pooler, порт 5432 (не Transaction :6543).
# Строка «Transaction pooler» в Dashboard даёт :6543 — для ./scripts/supabase-db-push.sh и psql
# часто нужна именно «Session pooler» :5432. Иначе возможны:
#   FATAL: Circuit breaker open: Unable to establish connection to upstream database
# Если используете 6543 в Node, в коде добавится pgbouncer=true (см. src/config/db.ts); при сбоях — :5432.
# Пример:
# DATABASE_URL=postgresql://postgres.xpefqjwxwgnkicizqyqx:<DB_PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# SKIP_DB_INIT_ON_START=true
#
# Чеклист деплоя (Portainer + Supabase):
# 1) Supabase: применить миграции — ./scripts/supabase-db-push.sh (корректный DATABASE_URL, порт pooler 5432).
# 2) Portainer API: DATABASE_URL, DB_SSL=true, DB_SSL_REJECT_UNAUTHORIZED=false, SKIP_DB_INIT_ON_START=true.
# 3) Собрать Flutter web с --dart-define=API_BASE_URL=<публичный URL API>.
# 4) Проверки: GET /health и GET / на API; CORS при другом origin при необходимости расширить в src/main.ts.
