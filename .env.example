# =============================================================================
# istochchnik_zhizni — шаблон окружения (скопируйте: cp .env.example .env)
# Стек: React (Vite) + Node/Express API + PostgreSQL
# Деплой: VPS/Docker (основной), Vercel только статический web + внешний API
# =============================================================================

# Одно имя проекта Docker Compose → одна сеть, DNS-имя db доступно из api.
# Без этого при разных папках/запусках появляются две сети (…_default) и ошибка getaddrinfo EAI_AGAIN db.
COMPOSE_PROJECT_NAME=istochchnik-zhizni

# --- Node API (хост + Docker) ---
# Локально на машине с npm run dev: лучше NODE_ENV=development (см. также .env.local.example)
NODE_ENV=production

# Порт API на хосте (проброс в контейнер :40978). Не меняйте контейнерный 40978 без правки docker/nginx-web.unified.conf.
PORT=40978

# К чему на хосте привязать порт API (docker-compose.yml). 127.0.0.1 — только локально; 0.0.0.0 — все интерфейсы.
# deploy-production.sh по умолчанию выставляет 127.0.0.1, если не задано.
API_PUBLISH=127.0.0.1

# CORS: перечислите Origin фронтенда без завершающего /. Пусто = любой Origin (для одного домена за nginx ок; в public API лучше задать явно).
# Пример: CORS_ALLOWED_ORIGINS=https://myapp.vercel.app,https://www.example.com
# Алиас: CORS_ORIGIN=...  |  JSON: CORS_ALLOWED_ORIGINS=["https://a.com","https://b.com"]
# CORS_ALLOWED_ORIGINS=

# Express за reverse proxy (nginx): X-Forwarded-* (по умолчанию вкл.). Локально без прокси: TRUST_PROXY=false
# TRUST_PROXY=true

# --- Realtime WebSocket (несколько инстансов API) ---
# Подключение к Redis включается только если задано одно из: REDIS_REALTIME_ENABLED=true ИЛИ непустой REDIS_URL.
# Иначе API не дергает 127.0.0.1:6379 при старте (нет спама ECONNREFUSED в логах).
# Локальный Redis:
# REDIS_REALTIME_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379
# Docker Compose (имя сервиса redis, не 127.0.0.1 из контейнера api):
# REDIS_URL=redis://redis:6379
# Явно выключить fan-out: REDIS_REALTIME_ENABLED=false

# Загрузки (фото/файлы в чате, аватары). В Docker без тома на этот каталог файлы исчезнут при пересборке контейнера — в БД останутся URL с 404.
# По умолчанию API пишет в ./uploads относительно рабочей директории (в образе: /app/uploads). Свой путь внутри контейнера:
# UPLOADS_DIR=/data/uploads
# Тогда в compose: volumes: - /var/lib/myapp/uploads:/data/uploads и UPLOADS_DIR=/data/uploads

# --- Supabase Storage (обязательно для вложений мессенджера) ---
# После `supabase db push` с миграцией storage_buckets_app_uploads: бакеты chat, user-media.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Локальный self-hosted Supabase в Docker: SUPABASE_URL=http://kong:8000 (из контейнера api)
# SUPABASE_SERVICE_ROLE_KEY=...   # только на сервере API, никогда в браузер / NEXT_PUBLIC_
# Id бакета вложений мессенджера в storage.buckets (по умолчанию в коде = chat, переменную можно не задавать).
# Если бакета нет: scripts/ensure-supabase-storage-buckets.sql в Dashboard → SQL, либо supabase db push (миграция storage_buckets_app_uploads).
# Если вложения уже в другом бакете — задайте его id (не «messenger», если такого бакета в проекте нет):
# SUPABASE_STORAGE_BUCKET_MESSENGER=my-existing-bucket-id
# SUPABASE_STORAGE_BUCKET_USER_MEDIA=user-media
# Публичный HTTPS-ориджин Storage для ответов API (обязательно, если SUPABASE_URL внутренний http://… или LAN).
# Иначе в JSON останутся http://192.168.x.x:8085/storage/... и HTTPS-сайт заблокирует картинки (mixed content).
#
# Вариант A — один ключ для «домена приложения» (удобно с docker-compose: тот же домен, что у SPA):
# PUBLIC_WEB_ORIGIN=https://app.example.ru
# …подставится и как публичный origin Storage на API, если SUPABASE_STORAGE_PUBLIC_URL пуст.
#
# Вариант B — явно только для Storage (Supabase Cloud или отдельный CDN):
# SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co
# Если тот же origin, что и SPA (например https://app.example.ru), на edge нужен proxy /storage/v1/ → Kong,
# иначе nginx с regex «*.jpg» отдаёт 404 на …/storage/v1/object/public/chat/…/file.jpg
# (см. deploy/nginx-supabase-storage-proxy.snippet и docker/nginx-web.unified.conf).
#
# Сборка SPA (docker-compose передаёт в web build из PUBLIC_WEB_ORIGIN / VITE_PWA_ORIGIN при необходимости):
# VITE_SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co
# Доп. внутренние ориджины для подмены на API (через запятую), если в БД URL с Docker bridge / не совпадают с SUPABASE_URL:
# SUPABASE_STORAGE_LEGACY_ORIGINS=http://172.17.0.1:8085,http://192.168.1.203:8085
# TTL signed URL для вложений (сек), API /api/messenger/messages/:id/attachment-url
# MESSENGER_ATTACHMENT_SIGNED_URL_TTL_SEC=3600
# Миграция legacy-вложений /uploads/... -> Supabase:
#   npm run messenger:migrate-legacy-uploads          # dry-run
#   npm run messenger:migrate-legacy-uploads -- --apply

# --- Мессенджер: минимум для стабильного прод (несколько инстансов API / балансировщик) ---
# 1) Redis fan-out WebSocket между процессами — иначе события видят только клиенты на том же инстансе.
#    В Docker (см. docker-compose.redis-addon.yml): REDIS_REALTIME_ENABLED=true и REDIS_URL=redis://redis:6379
#    На одном инстансе API без балансировки Redis не обязателен.
# 2) Том на каталог загрузок — см. UPLOADS_DIR выше и volume в docker-compose.prod.yml (без тома вложения/аватары 404 после деплоя).
# Проверки снаружи (подставьте свой домен и сессию, если нужен auth):
#   curl -fsS https://example.com/health
#   curl -fsS https://example.com/api/messenger/uploads/health
# Ответ всегда HTTP 200; смотрите JSON: "ok": true и "storage": "supabase" — загрузки доступны.
# Загрузка вложения требует cookie-сессии; health без авторизации.

# --- PostgreSQL (обязательно для API) ---
# Полный стек в Docker (api в контейнере): хост сервиса = db
DATABASE_URL=postgresql://postgres:postgres@db:5432/istochik_db
# Скрипт npm run db:seed-members с хоста сам подставит 127.0.0.1:${POSTGRES_HOST_PORT}, если видит @db:
# (внутри контейнера api имя db не меняется). Если порт БД не проброшен на хост (ECONNREFUSED) — сид через Postgres:
# npm run db:seed-members:docker
# API на хосте (npm run dev), Postgres в Docker: скопируйте .env.local.example → .env
# и используйте localhost + POSTGRES_HOST_PORT ниже.

# Порт Postgres на localhost при npm run db:up (файл docker-compose.local.yml). Если 5432 занят — поставьте 5433 и поправьте DATABASE_URL.
POSTGRES_HOST_PORT=5432

# Supabase / managed SSL:
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-....pooler.supabase.com:5432/postgres?sslmode=require
# npm run go:start / go:update: не поднимать локальный Postgres в Docker, если DATABASE_URL не @db: / localhost.
# Принудительно: LOCAL_DOCKER_DB=1 — всегда db:up; LOCAL_DOCKER_DB=0 — никогда db:up.
# LOCAL_DOCKER_DB=

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_DEBUG_LOG=false

# Категории событий календаря (админка + API): список id через запятую. Пусто = встроенный набор (service, worship, …).
# CHURCH_EVENT_ALLOWED_CATEGORIES=service,worship,prayer
# Значение по умолчанию при создании, если клиент не передал category — должно быть одним из разрешённых id.
# CHURCH_EVENT_DEFAULT_CATEGORY=service
# Для других NOT NULL колонок без DEFAULT: CHURCH_EVENT_DEFAULT_<ИМЯ_КОЛОНКИ_В_UPPERCASE>=допустимое_значение

# Пул соединений (опционально)
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=15000

# true = не вызывать initDb() при старте (схема уже на сервере, например Supabase после миграций)
SKIP_DB_INIT_ON_START=false

# --- Молитвенный цикл (якорь global_settings.start_date) ---
# Дата начала отсчёта цикла в формате YYYY-MM-DD. Без SYNC существующая строка в БД при обновлениях проекта НЕ перезаписывается.
# PRAYER_CYCLE_START_DATE=2026-03-05
# Синхронизировать якорь из .env при каждом старте API (удобно для фиксированного значения в деплое; перезапишет БД)
# PRAYER_CYCLE_SYNC_FROM_ENV=false
# Однократное принудительное выставление как SYNC (алиас по смыслу)
# PRAYER_CYCLE_FORCE_RESTORE=false

# Переменные только для сервиса Postgres в docker-compose.yml
POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Auth API ---
AUTH_SESSION_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5
# AES-256 ключ шифрования текста сообщений в БД (ровно 64 hex-символа, сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# MESSAGE_ENCRYPTION_KEY=
# SMS.ru интеграция для восстановления пароля
# SMS_RU_API_ID=ваш_api_id
# SMS_RU_FROM=ISTOCHNIK
# Соль для хеша OTP/токенов (любой длинный секрет)
# PASSWORD_RESET_CODE_SECRET=change-me-long-random-secret

# --- Web Push (PWA notifications) ---
# Generate once: npm run push:vapid
# Alternative CLI: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a contact URL, usually mailto:<your-email>
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
#
# --- TURN / WebRTC relay (Metered.ca) ---
# Используется только сервером API для выдачи временных credentials на /api/calls/ice-servers.
# Никогда не публикуйте API-ключ на фронтенде.
METERED_API_KEY=
METERED_DOMAIN=
#
# Важно: одна и та же пара VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY должна жить в .env / секретах Docker при каждом рестарте.
# Если генерировать новые ключи при деплое, старые подписки в браузерах перестанут работать, пока пользователь не переподпишется.
#
# Таймаут HTTP при отправке в FCM/Web Push (мс), по умолчанию 25000. При ETIMEDOUT в логах — проверьте исходящий HTTPS с VPS.
# PUSH_REQUEST_TIMEOUT_MS=40000
# Уведомление кураторам о назначениях: каждый понедельник в 08:00 (cron ниже) по таймзоне церкви.
# CURATOR_ASSIGNMENTS_PUSH_CRON=0 8 * * 1
# CURATOR_ASSIGNMENTS_PUSH_TZ=Europe/Moscow
# DISABLE_CURATOR_ASSIGNMENTS_PUSH_CRON=false
# Автораспределение по очереди недели (которое заполняет ответственных в "Сбор нужд · очередь недели")
# CURATOR_DISTRIBUTION_CRON=5 0 * * 1
# CURATOR_DISTRIBUTION_TZ=Europe/Moscow
# Границы пн–вс «эта / следующая неделя» в API календаря; по умолчанию = CURATOR_DISTRIBUTION_TZ или Europe/Moscow
# PRAYER_PLAN_WEEK_TZ=Europe/Moscow
# DISABLE_CURATOR_DISTRIBUTION_CRON=false
# Журнал приложения: еженедельная автоочистка (воскресенье, 03:15)
# APP_LOG_CLEANUP_CRON=15 3 * * 0
# APP_LOG_CLEANUP_TZ=Europe/Moscow
# DISABLE_APP_LOG_CLEANUP_CRON=false
# Срок хранения записей журнала (дни) и верхний лимит строк после очистки
# APP_LOG_RETENTION_DAYS=90
# APP_LOG_MAX_ROWS=3000

# --- Resources (RSS) ---
# RSS лента подкаста (сервер парсит и отдаёт в web-react через /api/resources/podcasts)
# RESOURCES_PODCAST_RSS_URL=https://your-podcast-host/rss.xml

# --- Docker: веб (nginx + React/Vite, см. Dockerfile.web) ---
WEB_PORT=8080
WEB_DIST_PATH=/opt/istochik-web
# Публичный URL SPA (без слэша в конце) — в manifest для PWA на iOS: абсолютный start_url/scope
# VITE_PWA_ORIGIN=https://app.church-tambov.ru

# Локальная разработка web-react (vite proxy), не используется при production build в Docker
# VITE_DEV_API_PROXY=http://127.0.0.1:40978

# =============================================================================
# Прочее (необязательно)
# =============================================================================
# Прямые загрузки из браузера в Storage по anon-ключу этим проектом не используются (загрузка через API + service role).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
