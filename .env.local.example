# Локальная разработка: API (npm run dev) на хосте + Postgres только в Docker.
# Скопируйте: cp .env.local.example .env
# Затем: npm run db:up   &&   npm run dev   (или npm run dev:all)

NODE_ENV=development
PORT=40978

# Postgres доступен на localhost — порт проброшен из docker-compose (POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/istochik_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
SKIP_DB_INIT_ON_START=false

POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

AUTH_SESSION_TTL_DAYS=30
# Время жизни access-сессии в минутах (cookie Max-Age и строка в БД). По умолчанию в коде 60.
# AUTH_ACCESS_TOKEN_TTL_MINUTES=60
# Срок refresh-токена в днях (HttpOnly auth_refresh_token). По умолчанию в коде 90 (как «остаться в аккаунте»).
# AUTH_REFRESH_TOKEN_TTL_DAYS=90
# Сколько устройств может быть одновременно «в аккаунте» (refresh). По умолчанию в коде 15.
# AUTH_MAX_REFRESH_SESSIONS_PER_USER=15
# Записей access-сессии (частые ротации токена). По умолчанию 30.
# AUTH_MAX_ACCESS_SESSIONS_PER_USER=30
# Общий лимит для обоих (если задан и отдельные переменные выше не заданы):
# AUTH_MAX_ACTIVE_SESSIONS_PER_USER=
# MESSAGE_ENCRYPTION_KEY=  # 64 hex-символа (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# TURN relay (Metered.ca) for reliable WebRTC in NAT-restricted networks.
METERED_API_KEY=
METERED_DOMAIN=

# --- Web Push (PWA notifications) ---
# Generate once from project root: npm run push:vapid
# VAPID_SUBJECT must be mailto:<your-email>
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Локально CORS можно не задавать (разрешены все origins).
# TRUST_PROXY=false

# Redis: при REDIS_URL hot-path сессий (grace refresh между инстансами, denylist access после logout).
# Выключить явно: REDIS_AUTH_SESSION_ENABLED=false
# REDIS_AUTH_SESSION_ENABLED=true

# Журнал приложения: автоочистка по воскресеньям в 03:15 (Europe/Moscow)
# APP_LOG_CLEANUP_CRON=15 3 * * 0
# APP_LOG_CLEANUP_TZ=Europe/Moscow
# DISABLE_APP_LOG_CLEANUP_CRON=false
# APP_LOG_RETENTION_DAYS=90
# APP_LOG_MAX_ROWS=3000

# --- GPTunnel (христианский ИИ помощник + RAG) ---
# AI_ENABLED=true
# AI_BASE_URL=https://gptunnel.ru/v1
# AI_MODEL=gpt-4o-mini
# GPTUNNEL_API_KEY=
# AI_API_KEY=   # можно тот же ключ
# GPTUNNEL_ASSISTANT_CODE=Christian

# --- Telegram (опционально) ---
# Токен и исходящий HTTP-прокси удобнее задавать в Админке → Telegram (хранятся в БД).
# Env — только fallback, если в настройках проекта прокси не включён:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HTTPS_PROXY=http://user:pass@host:8080
# HTTPS_PROXY=
# HTTP_PROXY=
