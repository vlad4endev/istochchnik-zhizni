# Опционально: Flutter web (legacy). Основной путь — Dockerfile.web (React/Vite).
FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app

ARG FLUTTER_STORAGE_BASE_URL=https://storage.googleapis.com
ARG PUB_HOSTED_URL=https://pub.dev
ENV FLUTTER_STORAGE_BASE_URL=${FLUTTER_STORAGE_BASE_URL}
ENV PUB_HOSTED_URL=${PUB_HOSTED_URL}

ARG API_BASE_URL=http://localhost:40978
ENV API_BASE_URL=$API_BASE_URL

COPY pubspec.yaml pubspec.lock ./
RUN flutter config --enable-web --no-analytics >/dev/null 2>&1 || true
RUN flutter pub get

COPY . .
RUN flutter build web --release \
  --base-href=/ \
  --no-web-resources-cdn \
  --dart-define=API_BASE_URL=$API_BASE_URL

RUN printf '%s\n' '{"apiBaseUrl":""}' > /app/build/web/api-config.json

FROM nginx:alpine
COPY docker/nginx-web.unified.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
