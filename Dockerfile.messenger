# Messenger: API + статика messenger-web (отдельный контейнер, порт 3002).
FROM node:22-alpine AS webbuild
WORKDIR /app

ARG VITE_CHAT_APP=true
ARG VITE_MAIN_APP_ORIGIN=
ARG VITE_MESSENGER_ORIGIN=
ENV VITE_CHAT_APP=$VITE_CHAT_APP
ENV VITE_MAIN_APP_ORIGIN=$VITE_MAIN_APP_ORIGIN
ENV VITE_MESSENGER_ORIGIN=$VITE_MESSENGER_ORIGIN

COPY web-react/package.json web-react/package-lock.json ./web-react/
COPY messenger-web/package.json messenger-web/package-lock.json ./messenger-web/
RUN cd messenger-web && npm ci

COPY web-react ./web-react/
COPY messenger-web ./messenger-web/
RUN cd messenger-web && npm run build

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS apibuild
WORKDIR /app
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && test -f dist/messengerMain.js

FROM node:20-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV MESSENGER_PORT=3002
ENV PORT=3002

RUN apk add --no-cache curl su-exec && \
  addgroup -g 1001 -S app && adduser -S app -u 1001 -G app

COPY package.json package-lock.json ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=apibuild /app/dist ./dist
COPY --from=webbuild /app/messenger-web/dist ./messenger-web/dist

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

RUN chown -R app:app /app

EXPOSE 3002

HEALTHCHECK --interval=20s --timeout=5s --start-period=50s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:3002/health" || exit 1

USER root
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/messengerMain.js"]
