{
  "expo": {
    "name": "Источник жизни",
    "slug": "istochnik-zhizni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7d3640"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.istochnikzhizni.molitva",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.istochnikzhizni.molitva",
      "adaptiveIcon": {
        "backgroundColor": "#7d3640",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "istochnik",
              "host": "incoming-call"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Приложению нужен микрофон, чтобы записывать голосовые сообщения в чатах."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы отправлять их в чатах.",
          "cameraPermission": "Приложению нужна камера, чтобы снимать и отправлять фото и видео в чатах.",
          "microphonePermission": "Приложению нужен микрофон, чтобы записывать видео со звуком."
        }
      ],
      "expo-document-picker",
      "react-native-reanimated",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Приложению нужна камера для видеозвонков.",
          "microphonePermission": "Приложению нужен микрофон для звонков."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7d3640",
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
