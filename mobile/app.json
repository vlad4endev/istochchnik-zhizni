{
  "expo": {
    "name": "Моя Церковь",
    "slug": "istochnik-zhizni",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "istochnik",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7d3640"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.istochnikzhizni.molitva",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Нужен доступ к микрофону для голосовых сообщений",
        "NSPhotoLibraryUsageDescription": "Нужен доступ к фото для публикаций, историй, чата и распознавания нот",
        "NSCameraUsageDescription": "Нужен доступ к камере для фото партитуры"
      },
      "associatedDomains": ["applinks:app.church-tambov.ru"]
    },
    "android": {
      "package": "com.istochnikzhizni.molitva",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#7d3640",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "app.church-tambov.ru",
              "pathPrefix": "/join"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "vladislav4endevs-team",
    "extra": {
      "eas": {
        "projectId": "2e8867ad-a0ba-423e-bd88-119b68bcf090"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Нужен доступ к микрофону для голосовых сообщений"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужен доступ к фото для публикаций, историй и распознавания нот",
          "cameraPermission": "Нужен доступ к камере для фото партитуры"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7d3640"
        }
      ]
    ]
  }
}
