{
  "expo": {
    "name": "Источник жизни",
    "slug": "istochnik-zhizni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7d3640"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.istochnikzhizni.molitva",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Нужен доступ к микрофону для голосовых сообщений",
        "NSPhotoLibraryUsageDescription": "Нужен доступ к фото для публикаций, историй и чата"
      }
    },
    "android": {
      "package": "com.istochnikzhizni.molitva",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#7d3640",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Нужен доступ к микрофону для голосовых сообщений"
        }
      ],
      "react-native-reanimated",
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужен доступ к фото для публикаций и историй"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7d3640"
        }
      ]
    ]
  }
}
