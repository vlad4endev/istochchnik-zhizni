{
  "name": "express-typescript-api",
  "version": "1.0.0",
  "description": "Node.js API with Express and TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/main.ts",
    "dev:all": "concurrently -k -n api,flutter -c blue,cyan \"npm run dev\" \"flutter run -d chrome --web-port=${FLUTTER_WEB_PORT:-8081} --dart-define=API_BASE_URL=${API_BASE_URL:-http://localhost:40978}\"",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d db",
    "dev:project": "bash ./scripts/dev-project.sh",
    "dev:start": "bash ./scripts/dev-project-bg.sh",
    "dev:start:fg": "bash ./scripts/dev-project.sh",
    "dev:stop": "bash ./scripts/dev-stop.sh",
    "dev:restart": "npm run dev:stop && npm run dev:start",
    "dev:status": "bash ./scripts/dev-status.sh",
    "dev:logs": "bash ./scripts/dev-logs.sh",
    "prod:start": "docker compose up -d --build",
    "prod:deploy": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "prod:deploy:prebuilt": "docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.web-prebuilt.yml up -d --build",
    "prod:deploy:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "prod:stop": "docker compose down",
    "prod:restart": "npm run prod:stop && npm run prod:start",
    "prod:status": "docker compose ps",
    "prod:logs": "docker compose logs -f --tail=200",
    "prod:fresh": "docker compose down -v && docker compose up -d --build",
    "build": "npx tsc",
    "start": "node dist/main.js",
    "lint": "npx eslint src --ext .ts",
    "lint:fix": "npx eslint src --ext .ts --fix",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "db:init": "npx ts-node scripts/runInitDb.ts",
    "quickstart": "bash scripts/quickstart.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
