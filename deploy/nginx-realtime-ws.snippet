# Фрагмент для основного nginx / NPM Advanced — если в консоли браузера:
#   WebSocket connection to 'wss://…/api/realtime' failed
#   close { code: 1006, wasClean: false }
# значит запрос до Node не доходит как WebSocket Upgrade (часто обычный HTTP прокси без Upgrade).
#
# 1) В начале server { } один раз:
#
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
#
# 2) В location, который отдаёт API на Node (порт 40978 или имя контейнера api):
#
# proxy_http_version 1.1;
# proxy_set_header Upgrade $http_upgrade;
# proxy_set_header Connection $connection_upgrade;
# proxy_read_timeout 86400s;
# proxy_send_timeout 86400s;
#
# 3) Nginx Proxy Manager: в записи прокси включите «Websockets Support».
# 4) Убедитесь, что /api на app-домене уходит на тот же процесс Express, где слушается upgrade на /api/realtime.
