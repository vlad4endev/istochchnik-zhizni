# Включите в server { … } того же vhost, что отдаёт SPA (например app.church-tambov.ru),
# если SUPABASE_STORAGE_PUBLIC_URL / VITE_SUPABASE_STORAGE_PUBLIC_URL указывают на этот хост,
# а Supabase Kong слушает на другом адресе (Docker bridge, отдельный порт).
#
# Симптом без этого блока: в DevTools 404 на URL вида …/storage/v1/object/public/chat/…/uuid.jpg —
# из-за общего location ~* \.(jpg|png|…)$ статика nginx перехватывает путь до proxy.
#
# Замените upstream на ваш Kong (порт как в SUPABASE_URL с хоста, часто 172.17.0.1:8085).

upstream supabase_kong {
    server 172.17.0.1:8085;
    keepalive 8;
}

location ^~ /storage/v1/ {
    proxy_pass http://supabase_kong;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
}
