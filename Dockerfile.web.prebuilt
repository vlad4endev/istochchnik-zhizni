# Только nginx + уже собранный Flutter web (без Flutter в образе).
# На сервере без доступа к storage.googleapis.com: соберите web локально и положите артефакты в release/web/
# (см. scripts/package-web-for-server.sh).

FROM nginx:alpine
COPY docker/nginx-web.unified.conf /etc/nginx/conf.d/default.conf
COPY release/web/ /usr/share/nginx/html/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
