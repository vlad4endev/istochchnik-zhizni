# React (Vite) + nginx: тот же origin для SPA и /api (прокси к сервису api в compose).
# public.ecr.aws — зеркало Docker Hub без лимита анонимных pull (429 на registry-1.docker.io).
FROM public.ecr.aws/docker/library/node:20-bookworm-slim AS build
WORKDIR /app

# Vite: только переменные с префиксом VITE_ доступны в import.meta.env при сборке.
ARG VITE_PWA_ORIGIN=
ENV VITE_PWA_ORIGIN=$VITE_PWA_ORIGIN
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_MESSENGER_ORIGIN=
ENV VITE_MESSENGER_ORIGIN=$VITE_MESSENGER_ORIGIN
ARG VITE_SUPABASE_STORAGE_PUBLIC_URL=
ENV VITE_SUPABASE_STORAGE_PUBLIC_URL=$VITE_SUPABASE_STORAGE_PUBLIC_URL
# Workbox runtime cache suffix в vite.config.ts (GITHUB_SHA → *-cache-<sha> при каждом деплое).
ARG GITHUB_SHA=
ENV GITHUB_SHA=$GITHUB_SHA

COPY web-react/package.json web-react/package-lock.json ./web-react/
# sharp (@capacitor/assets) не нужен для vite build; postinstall качает libvips с GitHub и часто падает по таймауту.
RUN cd web-react \
  && npm ci --ignore-scripts \
  && npm rebuild esbuild

COPY web-react ./web-react/
RUN cd web-react && npm run build

FROM public.ecr.aws/docker/library/nginx:alpine
COPY docker/nginx-web.unified.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web-react/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
