# Только nginx + уже собранный web-react (vite build → release/web/), без Node в образе.
# См. scripts/package-web-for-server.sh

FROM nginx:alpine
COPY docker/nginx-web.unified.conf /etc/nginx/conf.d/default.conf
COPY release/web/ /usr/share/nginx/html/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
