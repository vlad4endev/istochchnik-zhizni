# Локальная разработка: API (npm run dev) на хосте + Postgres только в Docker.
# Скопируйте: cp .env.local.example .env
# Затем: npm run db:up   &&   npm run dev   (или npm run dev:all)

NODE_ENV=development
PORT=40978

# Postgres доступен на localhost — порт проброшен из docker-compose (POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/istochik_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
SKIP_DB_INIT_ON_START=false

POSTGRES_DB=istochik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

AUTH_SESSION_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5

# Локально CORS можно не задавать (разрешены все origins).
# TRUST_PROXY=false
