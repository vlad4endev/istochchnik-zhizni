# Студия (редактор, сетлисты): VITE_APP_VARIANT=studio
FROM node:22-alpine AS build
WORKDIR /app

ARG VITE_APP_VARIANT=studio
ENV VITE_APP_VARIANT=$VITE_APP_VARIANT
ARG VITE_PWA_ORIGIN=
ENV VITE_PWA_ORIGIN=$VITE_PWA_ORIGIN
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY web-react/package.json web-react/package-lock.json ./web-react/
RUN cd web-react && npm ci

COPY web-react ./web-react/
RUN cd web-react && npm run build

FROM nginx:alpine
COPY docker/nginx-web.unified.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web-react/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
