# Dev / preview: куда проксировать /api и /health (см. vite.config.ts). Дефолт http://127.0.0.1:40978
# VITE_DEV_API_PROXY=http://127.0.0.1:40978
#
# Пустой VITE_API_BASE_URL в браузере = origin страницы, запросы идут на /api через прокси Vite
# Прод / другой хост бэкенда:
# VITE_API_BASE_URL=https://api.example.com
#
# Если в чате/профиле встречаются URL вида http://192.168…/storage/v1/… (mixed content на HTTPS),
# задайте публичный HTTPS origin (совпадает с PUBLIC_WEB_ORIGIN на API, если используете):
# VITE_SUPABASE_STORAGE_PUBLIC_URL=https://app.example.ru
# либо Supabase Cloud:
# VITE_SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co
# Тогда же исправляются ошибочные ссылки вида https://ваш-домен/storage/v1/... (404 без прокси Storage на nginx).
#
# Если ключа нет: на HTTPS фронт сам подставляет тот же origin, что и страница (`/storage/v1/...`) — нужен proxy
# `^~ /storage/v1/` в nginx (см. docker/nginx-web.unified.conf). Иначе задайте VITE_SUPABASE_STORAGE_PUBLIC_URL.
#
# Только если нужна явная подмена без эвристики:
# VITE_SUPABASE_STORAGE_PROXY_VIA_APP=true
# (опционально) тот же смысл, если в CI задан только этот ключ:
# VITE_API_URL=https://api.example.com
#
# Realtime (WebSocket /api/realtime): тот же хост, что и REST; в dev Vite проксирует ws вместе с /api (ws: true).
#
# Стабильный id PWA в манифесте (не менять между релизами, иначе ОС создаст «второе» приложение).
# VITE_PWA_MANIFEST_ID=istochchnik-zhizni-pwa
#
# Прод: полный URL фронта (без слэша в конце) — iOS лучше открывает standalone с абсолютным start_url/scope в manifest.
# VITE_PWA_ORIGIN=https://app.example.com
#
# Опционально: публичный VAPID для офлайна; в проде лучше брать с GET /api/notifications/vapid-public-key (дефолт в коде).
# VITE_VAPID_PUBLIC_KEY=
