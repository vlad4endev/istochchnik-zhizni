# Скопируйте этот файл в android/keystore.properties и заполните.
# keystore.properties и сами ключи (*.jks / *.keystore) в .gitignore — не коммитить.
#
# Создать ключ (один раз, сохранить в надёжном месте и сделать резервную копию —
# потеря ключа = переустановка приложения у всех пользователей):
#   keytool -genkey -v -keystore istochnik-release.jks -alias istochnik -keyalg RSA -keysize 2048 -validity 10000
#
# ВАЖНО: первый release-APK, подписанный этим ключом, НЕ встанет поверх установленных
# debug-сборок (другая подпись) — потребуется однократное удаление и новая установка.
# Пока keystore.properties отсутствует, build-apk.sh собирает release с debug-подписью:
# обновления продолжают ставиться поверх текущих версий.

# Путь к ключу относительно каталога android/
storeFile=istochnik-release.jks
storePassword=CHANGE_ME
keyAlias=istochnik
keyPassword=CHANGE_ME
