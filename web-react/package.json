{
  "name": "web-react",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package:server": "bash ../scripts/package-web-for-server.sh",
    "pwa:icons": "npx @vite-pwa/assets-generator assets/logo.svg -r ./public -p minimal -o",
    "pwa:splash": "npx pwa-asset-generator@8.1.4 public/assets/logo.svg public/pwa -b \"#f4f1ed\" -p \"18%\" -t png --splash-only --portrait-only -o",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "mobile:icons": "npx @capacitor/assets generate --ios --android --iconBackgroundColor '#7d3640' --iconBackgroundColorDark '#5c2830' --splashBackgroundColor '#f4f1ed' --splashBackgroundColorDark '#1c1917'",
    "mobile:build": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
